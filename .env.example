# Enable sync and create local SQLite databases in this directory for Node, Bun, and Vite dev.
# In Docker, the image uses /data and declares it as a persistent volume.
# LIDORA_DATA_DIR=./data

# Enable server-side polling when LIDORA_DATA_DIR is set.
# FEED_POLLING=true

# Number of reverse proxies in front of this server whose X-Forwarded-For entry
# identifies the client for proxy rate limits. Leave unset to use the socket
# address and ignore X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# Public origin of this deployment, used for OAuth issuer and resource URLs when
# a reverse proxy makes the request origin differ from the address clients use.
# PUBLIC_URL=https://lidora.example.com

# Persistent random secret of at least 32 characters; required for OAuth.
# Generate with openssl rand -hex 32 and retain across restarts and replicas.
# BETTER_AUTH_SECRET=
